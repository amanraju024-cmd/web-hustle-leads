rules_version = '2';

// AR Methods Leads — who can read and write what.
//
// Accounts: an account only gets access once it has a users/{uid} doc with
// active == true. The owner (OWNER_EMAIL) creates their own admin doc on first
// sign-in; every other account is created by an admin. Deactivating a user
// (active = false) cuts off all access immediately.
service cloud.firestore {
  match /databases/{database}/documents {

    function ownerEmail() { return 'amanraju024@gmail.com'; }
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function profile() { return get(userPath(request.auth.uid)).data; }
    function isActive() {
      return signedIn() && exists(userPath(request.auth.uid)) && profile().active == true;
    }
    function isAdmin() { return isActive() && profile().role == 'admin'; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function statuses() { return ['New', 'No answer', 'Call back', 'Interested', 'Not interested', 'Won']; }
    function callStatuses() { return ['No answer', 'Call back', 'Interested', 'Not interested', 'Won']; }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function shortString(v, max) { return v is string && v.size() <= max; }

    // Dates come from the server clock (Perth = UTC+8, no daylight saving), never the phone
    function pad2(n) { return (n < 10 ? '0' : '') + string(n); }
    function dayOf(t) { return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day()); }
    function perthNow() { return request.time + duration.value(8, 'h'); }
    function perthToday() { return dayOf(perthNow()); }
    function perthWeek() { return dayOf(perthNow() - duration.value(perthNow().dayOfWeek() - 1, 'd')); }
    function callPath(id) { return /databases/$(database)/documents/calls/$(id); }
    function leadPath(id) { return /databases/$(database)/documents/leads/$(id); }
    // What a lead has already earned (older leads without the flags count by their current status)
    function hadInterested(l) { return l.get('gotInterested', l.status == 'Interested' || l.status == 'Won'); }
    function hadWon(l) { return l.get('gotWon', l.status == 'Won'); }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isAdmin() || isMe(uid);
      // Owner bootstraps their own admin profile
      allow create: if isMe(uid)
        && request.auth.token.email == ownerEmail()
        && request.resource.data.role == 'admin'
        && request.resource.data.active == true
        && shortString(request.resource.data.name, 80);
      // Admin creates workers (or other admins)
      allow create: if isAdmin()
        && request.resource.data.role in ['worker', 'admin']
        && request.resource.data.active is bool
        && shortString(request.resource.data.name, 80)
        && shortString(request.resource.data.email, 200);
      // Admin can rename, change role, (de)activate, but never lock themselves out
      allow update: if isAdmin()
        && onlyChanged(['name', 'role', 'active', 'updatedAt'])
        && request.resource.data.role in ['worker', 'admin']
        && request.resource.data.active is bool
        && !(uid == request.auth.uid && (request.resource.data.active == false || request.resource.data.role != 'admin'));
      allow delete: if false;
    }

    // ---------- team settings ----------
    match /settings/team {
      allow read: if isActive();
      allow write: if isAdmin()
        && request.resource.data.dailyGoal is int
        && request.resource.data.dailyGoal >= 1
        && request.resource.data.dailyGoal <= 500
        && (!('commissionPct' in request.resource.data)
            || (request.resource.data.commissionPct is number && request.resource.data.commissionPct >= 0 && request.resource.data.commissionPct <= 100))
        && (!('brandLink' in request.resource.data) || (request.resource.data.brandLink is string && request.resource.data.brandLink.size() <= 200))
        && (!('brandPhone' in request.resource.data) || (request.resource.data.brandPhone is string && request.resource.data.brandPhone.size() <= 30));
    }
    // Google Maps data connection (Apify token): only signed-in team members can read it
    match /settings/integrations {
      allow read: if isActive();
      allow write: if isAdmin() && shortString(request.resource.data.apifyToken, 200);
    }

    // ---------- shared search results, so the team doesn't pay twice for the same search ----------
    match /searchCache/{key} {
      allow read: if isActive();
      allow write: if isActive()
        && request.resource.data.leads is list
        && request.resource.data.leads.size() <= 300
        && request.resource.data.uid == request.auth.uid;
    }

    // ---------- claims: one per business, readable by everyone so search can show "Taken by" ----------
    match /claims/{leadId} {
      allow read: if isActive();
      // A worker claims a business by creating its claim and lead together.
      // "create" only succeeds if no claim exists yet, so two people can't both claim it.
      allow create: if isActive()
        && request.resource.data.uid == request.auth.uid
        && shortString(request.resource.data.name, 80)
        && existsAfter(/databases/$(database)/documents/leads/$(leadId))
        && getAfter(/databases/$(database)/documents/leads/$(leadId)).data.assignedTo == request.auth.uid;
      allow create, update, delete: if isAdmin();
    }

    // ---------- leads ----------
    match /leads/{leadId} {
      function claimAfter() { return getAfter(/databases/$(database)/documents/claims/$(leadId)); }
      function claimedByMeInThisWrite() {
        return existsAfter(/databases/$(database)/documents/claims/$(leadId))
          && claimAfter().data.uid == request.auth.uid
          && !exists(/databases/$(database)/documents/claims/$(leadId));
      }

      allow read: if isAdmin() || (isActive() && resource.data.assignedTo == request.auth.uid);
      allow create, update, delete: if isAdmin();

      // Worker claims a brand-new business from search
      allow create: if isActive()
        && request.resource.data.assignedTo == request.auth.uid
        && request.resource.data.status == 'New'
        && shortString(request.resource.data.name, 200)
        && claimedByMeInThisWrite();

      // Worker claims an unassigned lead from the pool
      allow update: if isActive()
        && resource.data.assignedTo == null
        && request.resource.data.assignedTo == request.auth.uid
        && claimedByMeInThisWrite();

      // Worker works their own lead: notes/call-back on their own, or a status change that comes
      // with a brand-new call record in the same write (so every status change is a logged call)
      function callLogged() {
        let n = request.resource.data;
        let o = resource.data;
        let c = getAfter(callPath(n.lastCallId)).data;
        return onlyChanged(['status', 'notes', 'callbackAt', 'lastCalledAt', 'updatedAt', 'lastCallId', 'countedDay', 'gotInterested', 'gotWon'])
          && n.lastCallId is string
          && !exists(callPath(n.lastCallId))
          && existsAfter(callPath(n.lastCallId))
          && c.leadId == leadId && c.uid == request.auth.uid && c.status == n.status
          && n.status in callStatuses()
          && n.countedDay == c.day
          && n.gotInterested == (hadInterested(o) || n.status == 'Interested')
          && n.gotWon == (hadWon(o) || n.status == 'Won')
          && n.lastCalledAt == request.time;
      }
      allow update: if isActive()
        && resource.data.assignedTo == request.auth.uid
        && request.resource.data.assignedTo == request.auth.uid
        && shortString(request.resource.data.notes, 2000)
        && (onlyChanged(['notes', 'callbackAt', 'updatedAt']) || callLogged());
    }

    // ---------- call log (source of all stats) ----------
    // Fair points: a lead counts as one call per day; the Interested (+3) and Won (+10, deal value)
    // bonuses can each be earned once per lead, ever. The lead must be updated in the same write.
    match /calls/{callId} {
      function callOk() {
        let c = request.resource.data;
        let lead = get(leadPath(c.leadId)).data;
        return c.uid == request.auth.uid
          && c.status in callStatuses()
          && c.day == perthToday()
          && c.week == perthWeek()
          && c.createdAt == request.time
          && lead.assignedTo == request.auth.uid
          && getAfter(leadPath(c.leadId)).data.lastCallId == callId
          && c.counted == (lead.get('countedDay', '') != c.day ? 1 : 0)
          && c.bonusI == (c.status == 'Interested' && !hadInterested(lead) ? 1 : 0)
          && c.bonusW == (c.status == 'Won' && !hadWon(lead) ? 1 : 0)
          && c.points == c.counted + 3 * c.bonusI + 10 * c.bonusW
          && shortString(c.notes, 2000)
          && (c.bonusW == 1
              ? (c.value is number && c.value >= 0 && c.value <= 100000)
              : (!('value' in c) || c.value == 0));
      }
      allow read: if isAdmin() || (isActive() && resource.data.uid == request.auth.uid);
      allow create: if isActive() && callOk();
      // Admin can correct the amount on a won deal (the stats revenue is fixed in the same write)
      allow update: if isAdmin()
        && resource.data.status == 'Won' && ('value' in resource.data)
        && onlyChanged(['value', 'editedBy', 'editedAt'])
        && request.resource.data.value is number && request.resource.data.value >= 0 && request.resource.data.value <= 100000
        && request.resource.data.editedBy == request.auth.uid
        && request.resource.data.editedAt == request.time;
      allow delete: if isAdmin();
    }

    // ---------- daily stats per worker (leaderboards) ----------
    // stats/{day}_{uid}. Each write must add exactly one call that is created in the same batch.
    match /stats/{statId} {
      function d() { return request.resource.data; }
      function newCall() { return getAfter(/databases/$(database)/documents/calls/$(d().lastCallId)).data; }
      function callIsNewAndMine() {
        return d().lastCallId is string
          && !exists(/databases/$(database)/documents/calls/$(d().lastCallId))
          && existsAfter(/databases/$(database)/documents/calls/$(d().lastCallId))
          && newCall().uid == request.auth.uid
          && newCall().day == d().day;
      }
      function addsC() { return newCall().counted; }
      function addsI() { return newCall().bonusI; }
      function addsW() { return newCall().bonusW; }
      function addsV() { return newCall().bonusW == 1 ? newCall().value : 0; }
      function pointsOk() { return d().points == d().calls + 3 * d().interested + 10 * d().won; }

      allow read: if isActive();
      allow create: if isActive()
        && statId == d().day + '_' + request.auth.uid
        && d().uid == request.auth.uid
        && d().name == profile().name
        && d().week == newCall().week
        && callIsNewAndMine()
        && d().calls == addsC() && d().interested == addsI() && d().won == addsW()
        && d().get('revenue', 0) == addsV()
        && pointsOk();
      allow update: if isActive()
        && resource.data.uid == request.auth.uid
        && d().uid == resource.data.uid
        && d().name == profile().name
        && d().day == resource.data.day
        && d().week == resource.data.week
        && callIsNewAndMine()
        && d().calls == resource.data.calls + addsC()
        && d().interested == resource.data.interested + addsI()
        && d().won == resource.data.won + addsW()
        && d().get('revenue', 0) == resource.data.get('revenue', 0) + addsV()
        && pointsOk();
      // Admin deal-amount correction: only revenue changes
      allow update: if isAdmin() && onlyChanged(['revenue']) && d().revenue is number && d().revenue >= 0;
      allow delete: if isAdmin();
    }

    // ---------- searches and activity feed ----------
    match /searches/{id} {
      allow read: if isAdmin() || (isActive() && resource.data.uid == request.auth.uid);
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    // ---------- live team pop-ups ("Sam just closed a deal") ----------
    match /celebrations/{id} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['won', 'interested', 'badge', 'goal']
        && shortString(request.resource.data.text, 200);
      allow update: if false;
      allow delete: if isAdmin();
    }
    // Care plans (monthly income): anyone active can record one they sold; only admin sees all and manages them
    match /carePlans/{id} {
      function validPlan(d) {
        return d.client is string && d.client.size() >= 1 && d.client.size() <= 120
          && d.monthly is number && d.monthly > 0 && d.monthly <= 10000
          && d.startDay is string && d.startDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.status in ['active', 'cancelled']
          && shortString(d.notes, 500);
      }
      allow read: if isAdmin() || (isActive() && resource.data.soldBy == request.auth.uid);
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['client', 'leadId', 'monthly', 'startDay', 'status', 'cancelDay', 'notes', 'soldBy', 'soldByName', 'createdAt'])
        && validPlan(request.resource.data)
        && request.resource.data.status == 'active'
        && request.resource.data.soldBy == request.auth.uid
        && request.resource.data.soldByName == profile().name
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['client', 'monthly', 'startDay', 'status', 'cancelDay', 'notes'])
        && validPlan(request.resource.data);
      allow delete: if isAdmin();
    }
    // Team chat: everyone active reads and posts as themselves (name/role must match their profile); admin can delete
    match /messages/{id} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == profile().name
        && request.resource.data.role == profile().role
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /events/{id} {
      allow read: if isAdmin();
      allow create: if isActive()
        && request.resource.data.uid == request.auth.uid
        && shortString(request.resource.data.text, 500);
      allow update, delete: if false;
    }
  }
}
